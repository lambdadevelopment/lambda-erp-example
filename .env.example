# Copy to .env and adjust. These are read by the core backend.

# Load this repo's plugin (acme/plugin.py register()). Comma-separated for more.
LAMBDA_ERP_PLUGINS=acme

# Where the SQLite database lives.
LAMBDA_ERP_DB=./acme.db

# Auto-seed demo data on first boot (handy for a demo; 0 for a clean private
# instance). The shared public_manager login of the public demo additionally
# needs LAMBDA_ERP_ENABLE_PUBLIC_DEMO=1; leave that off anywhere else.
LAMBDA_ERP_AUTO_DEMO=0
LAMBDA_ERP_ENABLE_PUBLIC_DEMO=0

# Stable secret for signing login cookies. Set it and keep it constant across
# deploys and replicas (required with Postgres); unset, the app generates one
# and everyone is logged out on restart. Generate: openssl rand -hex 32
# JWT_SECRET_KEY=

# The public https address of this ERP. Needed behind a TLS proxy: social
# sign-in redirects and MCP / OAuth discovery (how lambda.dev, Claude or
# ChatGPT connect to the ERP) use it. app.py also takes it as MCP_PUBLIC_URL.
# OAUTH_REDIRECT_BASE=https://erp.example.com

# OpenAI key for the chat features (optional for a static demo; required to
# drive the system via chat).
# OPENAI_API_KEY=

# Or, instead of your own OpenAI key: Lambda's model gateway (lambda.dev),
# billed to your Lambda organization (lambda-erp >= 1.4.1). Off by default.
# LAMBDA_ERP_LLM_PROVIDER=lambda
# LAMBDA_LLM_API_KEY=lambda_...

# Frontend dev only: override the API base (defaults to same-origin "/api").
# VITE_API_BASE=http://localhost:8000/api
